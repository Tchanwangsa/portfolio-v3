# Local API settings. Copy to server/.env.dev.
STATS_LISTEN_ADDR=127.0.0.1:8787
STATS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
STATS_DATA_FILE=data/agentic-stats.json

# Shared by the API and `go run ./telemetry run`. Token needs at least 32 random characters.
STATS_PUBLISH_URL=http://127.0.0.1:8787/api/agentic-stats
STATS_PUBLISH_TOKEN=

# Optional GitHub card. See README.md for token scopes.
GITHUB_USERNAME=
GITHUB_TOKEN=
GITHUB_PRIVATE_TOKEN=

# Optional Strava card. At least 32 random characters, different from STATS_PUBLISH_TOKEN.
RUNS_WEBHOOK_TOKEN=
