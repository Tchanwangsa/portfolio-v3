# Server settings. Prefer setting the publish token as a hosting secret.
STATS_LISTEN_ADDR=:8080
STATS_ALLOWED_ORIGINS=https://tchawangsa.xyz
STATS_DATA_FILE=/data/agentic-stats.json
STATS_PUBLISH_TOKEN=

# Set this on the machine running the collector with the same publish token.
STATS_PUBLISH_URL=https://api.tchawangsa.xyz/api/agentic-stats
