{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "regions": ["syd1"],
  "rewrites": [
    {"source": "/healthz", "destination": "/api/portfolio?__portfolio_route=/healthz"},
    {"source": "/api/agentic-stats", "destination": "/api/portfolio?__portfolio_route=/api/agentic-stats"},
    {"source": "/api/github-stats", "destination": "/api/portfolio?__portfolio_route=/api/github-stats"},
    { "source": "/projects/:path*", "destination": "/index.html" },
    { "source": "/blog/:path*", "destination": "/index.html" },
    { "source": "/blogs/:path*", "destination": "/index.html" }
  ]
}
